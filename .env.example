# ---------------------------------------------------------------------------
# CareLibre server — local development configuration.
# Copy to `.env` (`make setup`) and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development

# host:port to listen on
BIND_ADDR=0.0.0.0:8080

# PostgreSQL connection string
DATABASE_URL=postgres://carelibre:carelibre@localhost:5432/carelibre

# Connection pool size
DB_MAX_CONNECTIONS=10

# Apply pending migrations on startup
RUN_MIGRATIONS=true

# REQUIRED in production. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=development-only-secret-change-me-please-32-chars

# Access token lifetime (seconds)
ACCESS_TOKEN_TTL_SECS=900

# Refresh token lifetime (seconds, default 30 days)
REFRESH_TOKEN_TTL_SECS=2592000

# Comma-separated list of allowed browser origins for CORS.
# Leave empty for same-origin/desktop clients. Never use "*" in production.
CORS_ALLOWED_ORIGINS=

# Log filter
RUST_LOG=info,carelibre_server=debug,tower_http=info,sqlx=warn
